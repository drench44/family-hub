[Unit]
Description=Hourly family-hub SQLite snapshot (tiered: hourly/daily/weekly/monthly)

[Timer]
# Top of every hour. The script keeps 48 hourly + 14 daily + 8 weekly +
# 12 monthly snapshots, so hourly runs stay cheap on storage. Persistent=true
# runs a missed snapshot after the box was off.
OnCalendar=hourly
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
