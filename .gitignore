# Box-only state + secrets — never committed.
data/
# Written into the staged tree by the deploy (commit + config hash), never here.
src/family_hub/build_info.json
config.json
.env
scripts/token.json
scripts/client_secret.json
.mcp.json

# Python / test cruft
__pycache__/
*.pyc
.pytest_cache/
.venv/
.claude/
# Machine-made files that can hold local paths or real data: test coverage
# (it records full file paths), SQLite databases, macOS folder metadata.
.coverage
.coverage.*
htmlcov/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.DS_Store

# Clubhouse agent manager
.clubhouse/agents/
.clubhouse/.local/
.clubhouse/agents.json
.clubhouse/agents.json.bak
.clubhouse/settings.local.json

# Playwright MCP browser-session artifacts (snapshots can contain real
# house data — never commit)
.playwright-mcp/
